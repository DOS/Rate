{
  "manifest_version": 3,
  "name": "Rate.vn - So Sánh Giá, Lịch Sử Giá & Lọc Đánh Giá Ảo AI",
  "short_name": "Rate.vn",
  "version": "2.0.0",
  "description": "Kiểm tra lịch sử giá 90 ngày, phát hiện giảm giá ảo, tìm nơi bán rẻ hơn và lọc đánh giá seeding bằng AI trên Shopee, Lazada, Tiki.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mở bảng phân tích giá & độ tin cậy Rate.vn",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "https://shopee.vn/*",
    "https://*.lazada.vn/*",
    "https://tiki.vn/*",
    "https://cellphones.com.vn/*",
    "https://*.thegioididong.com/*",
    "https://fptshop.com.vn/*",
    "https://rate.vn/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shopee.vn/*",
        "https://*.lazada.vn/*",
        "https://tiki.vn/*",
        "https://cellphones.com.vn/*",
        "https://*.thegioididong.com/*",
        "https://fptshop.com.vn/*"
      ],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
