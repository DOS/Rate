# @repo/crawlers - copy to .env (never commit .env)

# Supabase (server-side only; the secret key sb_secret_... bypasses RLS)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# LLM for AiSpecEnricher and AiReviewAnalyzer
# AI_PROVIDER: dos-ai | openai | gemini | deepseek | groq | openrouter | ollama
# When AI_PROVIDER is empty the provider is picked in this order:
#   DOS_AI_API_KEY or DOS_AI_BASE_URL -> dos-ai, OPENAI_API_KEY -> openai,
#   GEMINI_API_KEY or GOOGLE_API_KEY -> gemini, DEEPSEEK_API_KEY -> deepseek,
#   GROQ_API_KEY -> groq, OPENROUTER_API_KEY -> openrouter, otherwise openai.
AI_PROVIDER=
# AI_API_KEY is a generic fallback: each provider reads its own key first
# (openai reads AI_API_KEY before OPENAI_API_KEY).
AI_API_KEY=
# AI_BASE_URL, then DOS_AI_BASE_URL, then OPENAI_BASE_URL override the provider's default URL.
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=25000

# Provider-specific keys. The review AI points job (jobs/review-ai-points.ts) uses only
# DOS_AI_API_KEY (a dos_sk_ key) and DOS_AI_BASE_URL (default https://api.dos.me/v1),
# with REVIEW_AI_POINTS_ENABLED=true and REVIEW_AI_MODEL (dos or qwen3.8-max).
DOS_AI_API_KEY=
DOS_AI_BASE_URL=
REVIEW_AI_POINTS_ENABLED=
REVIEW_AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
