# @repo/crawlers - copy to .env (never commit .env)

# Supabase (server-side only; the service role key bypasses RLS)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# LLM for AiSpecEnricher and AiReviewAnalyzer
# AI_PROVIDER: dos-ai | openai | gemini | deepseek | groq | openrouter | ollama
# Leave it empty to pick the provider from whichever key below is set.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=25000

# Provider-specific keys (optional, used when AI_API_KEY is empty)
DOS_AI_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
