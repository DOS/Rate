{
  "name": "@repo/crawlers",
  "version": "2.0.0",
  "private": true,
  "description": "Open-Core Product Normalization, 3-Tier Entity Matching, AI 10-Group Spec Enricher & Anti-Seeding Review Intelligence Engine for Rate Platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./shopee/logger": {
      "types": "./dist/shopee/logger.d.ts",
      "import": "./dist/shopee/logger.js"
    },
    "./shopee/arena-spec-syncer": {
      "types": "./dist/shopee/arena-spec-syncer.d.ts",
      "import": "./dist/shopee/arena-spec-syncer.js"
    },
    "./shopee/flagship-seed-data": {
      "types": "./dist/shopee/flagship-seed-data.d.ts",
      "import": "./dist/shopee/flagship-seed-data.js"
    },
    "./shopee/jobs/backfill-specs": {
      "types": "./dist/shopee/jobs/backfill-specs.d.ts",
      "import": "./dist/shopee/jobs/backfill-specs.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "backfill:specs": "tsx src/shopee/jobs/backfill-specs.ts",
    "test": "tsx src/shopee/__tests__/open-core-intelligence.test.ts && tsx src/shopee/__tests__/entity-matcher.test.ts && tsx src/shopee/test-review-analyzer.ts",
    "test:dist": "node src/shopee/__tests__/dist-exports.smoke.mjs"
  },
  "keywords": [
    "product-normalizer",
    "entity-matcher",
    "ai-spec-enricher",
    "ai-review-analyzer",
    "supabase",
    "rate-platform"
  ],
  "author": "JOY",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@repo/shared-data": "workspace:*",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
