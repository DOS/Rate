# @repo/web - copy to apps/web/.env.local (never commit it)

# Supabase (required). src/lib/rate-api.ts throws when these are missing,
# so a preview never reads the prod project by accident.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only, bypasses RLS - never expose it to the client. Used by the
# Extension write path (src/server/rate/extension.ts) and POST /api/v1/rate/watchlist
# (getRateClient from @repo/shared-data).
SUPABASE_SERVICE_ROLE_KEY=

# Site
APP_PUBLIC_URL=https://rate.vn
# Base URL for the /leaderboard metadata (default https://rate.vn)
# NEXT_PUBLIC_SITE_URL=https://rate.vn
# APP_ENV=development
# next.config.mjs "output": standalone | export | (unset for next start)
# NEXT_OUTPUT=
# webpack cache type: filesystem (default) | memory
# WEBPACK_CACHE_TYPE=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
