# @repo/web - copy to apps/web/.env.local (never commit it)

# Supabase (required). src/lib/rate-api.ts throws when these are missing,
# so a preview never reads the prod project by accident.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The web app never reads the Supabase secret key (SUPABASE_SECRET_KEY): reads
# use the anon/publishable key and writes run as the signed-in user. ESLint
# bans it in src/app and src/server.

# Site
APP_PUBLIC_URL=https://rate.vn
# Base URL for the /leaderboard metadata (default https://rate.vn)
# NEXT_PUBLIC_SITE_URL=https://rate.vn
# APP_ENV=development
# next.config.mjs "output": standalone | export | (unset for next start)
# NEXT_OUTPUT=
# webpack cache type: filesystem (default) | memory
# WEBPACK_CACHE_TYPE=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
