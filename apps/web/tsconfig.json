{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "server-only": ["./src/server/rate/server-only.ts"]
    },
    "types": []
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "**/*.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "prettier.config.js"
  ],
  "exclude": ["node_modules"],
  "typeAcquisition": {
    "enable": false
  }
}
