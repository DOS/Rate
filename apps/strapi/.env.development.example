# Strapi Development Environment
# Rename to .env or .env.development to use locally

# ----- Strapi -----
HOST=0.0.0.0
PORT=1337

APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt
JWT_SECRET=change-me-user-jwt
TRANSFER_TOKEN_SALT=change-me-transfer-salt

APP_URL=http://localhost:1337
# STRAPI_ADMIN_BACKEND_URL=http://localhost:1337

# ----- Preview -----
CLIENT_URL=http://localhost:3000
STRAPI_PREVIEW_ENABLED=true
STRAPI_PREVIEW_SECRET=change-me-preview-secret

# ----- Database (PostgreSQL 17 local) -----
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rate_db
DATABASE_USERNAME=JOY
DATABASE_PASSWORD=change-me-password
DATABASE_SSL=false

# ----- Optional providers -----
