{
  "kind": "collectionType",
  "collectionName": "example_features",
  "info": {
    "singularName": "example-feature",
    "pluralName": "example-features",
    "displayName": "Example Feature",
    "description": "Example content type for demonstration"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200,
      "minLength": 1
    },
    "description": {
      "type": "text",
      "maxLength": 5000
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "technology",
        "finance",
        "education",
        "healthcare",
        "other"
      ],
      "default": "other"
    },
    "priority": {
      "type": "integer",
      "min": 1,
      "max": 10,
      "default": 5
    },
    "tags": {
      "type": "json"
    },
    "metadata": {
      "type": "json"
    },
    "thumbnail": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "attachments": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "relatedFeatures": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::example-feature.example-feature"
    }
  }
}