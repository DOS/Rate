# Development-specific environment variables
# This file overrides .env in development mode

# Disable auto-reload to prevent data loss
STRAPI_DISABLE_AUTORELOAD=false

# Use development database to protect production data
DATABASE_NAME=rate_db_dev

# Enable debug mode for better error messages
DEBUG=strapi:*

# Disable telemetry in development
STRAPI_TELEMETRY_DISABLED=true

# Cache configuration
CACHE_ENABLED=false

# Set longer timeouts for development
DATABASE_CONNECTION_TIMEOUT=120000

# Prevent schema auto-sync issues
DATABASE_FORCE_MIGRATION=false