# Strapi Production Environment
# Copy to your deployment and fill secure values

HOST=0.0.0.0
PORT=1337

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
JWT_SECRET=
TRANSFER_TOKEN_SALT=

APP_URL=https://your-domain.example
# STRAPI_ADMIN_BACKEND_URL=https://your-domain.example

# Preview
CLIENT_URL=https://your-frontend.example
STRAPI_PREVIEW_ENABLED=false
STRAPI_PREVIEW_SECRET=

# Database (use DATABASE_URL if preferred)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_CLIENT=postgres
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=true

# Providers
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=
# AWS_BUCKET=
# AWS_ACL=public-read
# AWS_SIGNED_URL_EXPIRES=900
# CDN_URL=
# CDN_ROOT_PATH=

# Email
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_HOST=https://api.eu.mailgun.net
# MAILGUN_EMAIL=

# Monitoring
# SENTRY_DSN=


