{
  "name": "@repo/strapi",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "types": "./types",
  "scripts": {
    "build": "strapi build",
    "config:dump": "strapi configuration:dump -f dump.json",
    "config:restore": "strapi configuration:restore -f dump.json",
    "dev": "yarn develop",
    "develop": "strapi develop",
    "develop:watch": "strapi develop --watch-admin",
    "export:all": "strapi export --file strapi-export --no-encrypt",
    "export:content": "strapi export --only content --no-encrypt --file strapi-export",
    "generate": "strapi generate",
    "generate:types": "strapi ts:generate-types",
    "import": "strapi import -f strapi-export.tar.gz",
    "run:db": "docker compose up -d db",
    "start": "strapi start",
    "strapi": "strapi",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit --detectOpenHandles",
    "transfer": "strapi transfer"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      ".tmp",
      ".cache"
    ]
  },
  "dependencies": {
    "@keyv/redis": "^5.1.2",
    "@radix-ui/react-use-effect-event": "^0.0.2",
    "@repo/design-system": "*",
    "@repo/shared-data": "*",
    "@strapi-community/plugin-redis": "^2.0.0",
    "@strapi-community/plugin-rest-cache": "^5.0.1",
    "@strapi-community/provider-rest-cache-redis": "^5.0.0",
    "@strapi/admin": "^5.24.1",
    "@strapi/content-manager": "^5.24.1",
    "@strapi/content-type-builder": "^5.24.1",
    "@strapi/email": "^5.24.1",
    "@strapi/plugin-color-picker": "^5.24.1",
    "@strapi/plugin-sentry": "^5.24.1",
    "@strapi/plugin-seo": "^2.0.8",
    "@strapi/plugin-users-permissions": "^5.24.1",
    "@strapi/provider-email-mailgun": "^5.24.1",
    "@strapi/provider-upload-aws-s3": "^5.24.1",
    "@strapi/strapi": "^5.24.1",
    "@strapi/upload": "^5.24.1",
    "bullmq": "^5.58.5",
    "cache-manager": "^7.2.2",
    "formdata-node": "^6.0.3",
    "ioredis": "^5.7.0",
    "keyv": "^5.5.2",
    "lodash": "^4.17.21",
    "node-fetch": "^3.3.2",
    "pg": "^8.13.1",
    "prismjs": "^1.30.0",
    "qs": "^6.13.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-router-dom": "^6.0.0",
    "react-select": "^5.10.1",
    "redis": "^5.8.2",
    "strapi-plugin-config-sync": "3.1.1",
    "strapi-v5-plugin-populate-deep": "^4.0.5",
    "styled-components": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/react-select": "^5.0.1",
    "typescript": "^5"
  },
  "engines": {
    "node": "22.x.x",
    "yarn": "1.22.x"
  },
  "strapi": {
    "uuid": "@repo/strapi"
  }
}
