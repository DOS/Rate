# Local Private Repo Junction & Multi-Root Workspace (Never commit private Rate-Services into public Open-Core repo)
/Rate-Services
/Rate-Services/
Rate.code-workspace


# Playwright HTML report
playwright-report/

# Secrets and local data that must never be committed (DOS/Rate#153):
# Windows Explorer copies (English "x - Copy.env", Vietnamese "x - Bản sao"),
# any *.env file, SQL files outside the migrations folder (dumps, ad-hoc
# scripts with passwords), captured request headers and browser sessions.
*.env
*.env.*
*.sql
!supabase/migrations/*.sql
# Reviewed E2E fixture: synthetic catalog rows only, no credentials.
!apps/web/e2e/seed.sql
# Reviewed DOS-Me migration proposal (DOS/Rate#1150): DDL only, no data, no credentials.
!Docs/Proposals/2026-10-28-dos-me-m1-m2-items.sql
!Docs/Proposals/2026-10-28-dos-me-m1-m2-items-rollback.sql
!Docs/Proposals/2026-10-28-dos-me-m1-m2-items-verify.sql
!Docs/Proposals/2026-10-29-dos-me-m0-seed-rekey.sql
!Docs/Proposals/2026-10-29-dos-me-m0-seed-rekey-rollback.sql
!Docs/Proposals/2026-10-29-dos-me-m0-seed-rekey-verify.sql
* - Copy*
* - Bản sao*
*.dump
*.sql.gz
*.har
header*.txt
cookies*.json
storage-state*.json
storageState*.json
**/playwright/.auth/

# Example env files and env-named source modules stay tracked. These negations
# must stay at the end of the file: ".env*" and "*.env.*" above would win.
!.env.example
!*.env.example
!*.env.ts
!*.env.mts
!*.env.js
!*.env.mjs
!*.env.d.ts
