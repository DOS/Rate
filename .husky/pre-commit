echo '🏗️👷 Styling your changes before committing 👷‍♂️🏗️'

git rev-parse -q --no-revs --verify MERGE_HEAD || npx lint-staged --verbose --concurrent false

# Block staged secrets before they reach the remote (DOS/Rate#153). The
# "Secret scan" workflow runs on every pull request; this gives an earlier
# answer. Merges are skipped like lint-staged above: what they bring in was
# already scanned on its own branch. Without gitleaks 8.19+ (the "git"
# subcommand), print how to get it instead of blocking the commit.
if git rev-parse -q --no-revs --verify MERGE_HEAD >/dev/null; then
  :
elif gitleaks git --help >/dev/null 2>&1; then
  gitleaks git --staged --redact --verbose --no-banner --exit-code 1 . || exit 1
else
  echo 'gitleaks 8.19+ not found: staged secrets are not checked locally (https://github.com/gitleaks/gitleaks#installing)'
fi
