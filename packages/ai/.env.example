# AI Service Configuration
# Copy this file to .env and fill in your values

# Provider Selection (openai | selfhosted)
AI_PROVIDER=openai

# OpenAI Configuration (for MVP)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Cache Settings
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600 # 1 hour in seconds
AI_CACHE_KEY_PREFIX=ai:analysis:

# Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_HOUR=1000

# Self-Hosted Configuration (for future use)
# Uncomment these when migrating from OpenAI
# AI_PROVIDER=selfhosted
# PHOBERT_URL=http://localhost:5000
# LLAMA_URL=http://localhost:8080
# SELFHOSTED_TIMEOUT=5000 # milliseconds
# GPU_ENABLED=true
# MODEL_PATH=/models

# Monitoring & Logging
AI_LOG_LEVEL=info # debug | info | warn | error
AI_METRICS_ENABLED=true
AI_METRICS_PORT=9090

# Security
AI_MAX_INPUT_LENGTH=10000 # characters
AI_SANITIZE_INPUT=true
AI_REDACT_PII=true

# Batch Processing
AI_BATCH_MAX_SIZE=50
AI_BATCH_TIMEOUT=30000 # milliseconds

# Webhook for async results (optional)
# AI_WEBHOOK_URL=https://your-app.com/webhook/ai-results
# AI_WEBHOOK_SECRET=your-webhook-secret

# Database (for storing results)
DATABASE_URL=postgresql://JOY:password@localhost:5432/rate_db

# Feature Flags
AI_ENABLE_SPAM_DETECTION=true
AI_ENABLE_FAKE_REVIEW_DETECTION=true
AI_ENABLE_SENTIMENT_ANALYSIS=true
AI_ENABLE_RULES_ENGINE=true

# Vietnamese-specific settings
AI_VIETNAMESE_DIALECT_DETECTION=true
AI_VIETNAMESE_SLANG_DETECTION=true

# Cost Management
AI_MONTHLY_BUDGET_USD=100
AI_ALERT_AT_PERCENTAGE=80 # Alert when 80% of budget used

# Development/Testing
AI_DRY_RUN=false # Set to true to skip actual API calls
AI_MOCK_RESPONSES=false # Set to true to return mock data