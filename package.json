{
  "name": "rate-platform",
  "version": "2.0.0",
  "private": true,
  "author": {
    "name": "JOY",
    "email": "joy@rate.vn",
    "url": "https://rate.vn"
  },
  "maintainers": [
    {
      "name": "JOY",
      "email": "joy@rate.vn",
      "url": "https://rate.vn"
    }
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build --cache-dir=.turbo",
    "build:web": "turbo run build --filter=@repo/web",
    "build:crawler": "turbo run build --filter=@repo/crawlers",
    "commit": "git-cz",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:crawler": "turbo run dev --filter=@repo/crawlers",
    "format": "prettier --write --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "format:check": "prettier --check --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "preinstall": "npx only-allow pnpm",
    "lint": "turbo lint",
    "prepare": "husky || true",
    "start:web": "turbo run start --filter=@repo/web",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,css,scss}": "prettier --write --ignore-unknown"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@playwright/test": "^1.52.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "1.13.3",
    "@swc/core-win32-x64-msvc": "1.13.3",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.1",
    "lint-staged": "16.1.0",
    "next": "^16.3.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@swc/core",
      "sharp"
    ],
    "overrides": {
      "eslint": "^8.57.0",
      "@typescript-eslint/eslint-plugin": "^8.71.2",
      "@typescript-eslint/parser": "^8.71.2",
      "@typescript-eslint/typescript-estree": "^8.71.2",
      "@typescript-eslint/eslint-plugin>typescript": "6.0.3",
      "@typescript-eslint/parser>typescript": "6.0.3",
      "@typescript-eslint/typescript-estree>typescript": "6.0.3",
      "@typescript-eslint/type-utils>typescript": "6.0.3",
      "ts-api-utils>typescript": "6.0.3",
      "@swc/core": "1.13.3",
      "@swc/core-win32-x64-msvc": "1.13.3"
    }
  },
  "dependencies": {
    "@next/eslint-plugin-next": "15.3.3",
    "@t3-oss/env-nextjs": "0.13.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "animate.css": "^4.1.1",
    "axios": "^1.9.0",
    "eslint-config-prettier": "10.1.5",
    "lucide-react": "0.513.0",
    "playwright": "^1.52.0",
    "zod": "^3.25.76"
  }
}
