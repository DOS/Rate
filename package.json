{
  "name": "rate-box",
  "version": "2.0.0",
  "private": true,
  "author": {
    "name": "JOY",
    "email": "joy@rate.box",
    "url": "https://rate.box"
  },
  "maintainers": [
    {
      "name": "JOY",
      "email": "joy@rate.box",
      "url": "https://rate.box"
    }
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build --cache-dir=.turbo",
    "build:web": "turbo run build --filter=@repo/web",
    "build:crawler": "turbo run build --filter=@repo/crawlers",
    "commit": "git-cz",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:crawler": "turbo run dev --filter=@repo/crawlers",
    "format": "prettier --write --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "format:check": "prettier --check --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "preinstall": "npx only-allow pnpm",
    "lint": "turbo lint",
    "prepare": "husky",
    "start:web": "turbo run start --filter=@repo/web",
    "type-check": "turbo type-check"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@playwright/test": "^1.52.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.1",
    "lint-staged": "16.1.0",
    "prettier": "3.5.3",
    "turbo": "^2.0.9"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "comments": {
    "prettier": "bump to 3.3.3 destroys types schemas generated by Strapi (@strapi/typescript-utils > generators > utils > prettier.format())"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "15.3.3",
    "@t3-oss/env-nextjs": "0.13.6",
    "@typescript-eslint/eslint-plugin": "8.33.1",
    "@typescript-eslint/parser": "8.33.1",
    "animate.css": "^4.1.1",
    "axios": "^1.9.0",
    "eslint-config-prettier": "10.1.5",
    "lucide-react": "0.513.0",
    "playwright": "^1.52.0",
    "zod": "^3.25.56"
  }
}
