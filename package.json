{
  "name": "rate-platform",
  "version": "2.0.0",
  "private": true,
  "author": {
    "name": "JOY",
    "email": "joy@rate.vn",
    "url": "https://rate.vn"
  },
  "maintainers": [
    {
      "name": "JOY",
      "email": "joy@rate.vn",
      "url": "https://rate.vn"
    }
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo build --cache-dir=.turbo",
    "check:migrations": "node scripts/check-migration-drift.mjs",
    "test:migrations": "node scripts/test-migration-replay.mjs",
    "build:web": "turbo run build --filter=@repo/web",
    "build:crawler": "turbo run build --filter=@repo/crawlers",
    "commit": "git-cz",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@repo/web",
    "dev:crawler": "turbo run dev --filter=@repo/crawlers",
    "format": "prettier --write --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "format:check": "prettier --check --cache --ignore-unknown \"**/*.{js,jsx,ts,tsx,md,css,scss}\"",
    "preinstall": "npx only-allow pnpm",
    "lint": "turbo lint",
    "prepare": "husky || true",
    "start:web": "turbo run start --filter=@repo/web",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,css,scss}": "prettier --write --ignore-unknown"
  },
  "prettier": "@repo/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@playwright/test": "^1.52.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@swc/core": "1.13.3",
    "@swc/core-win32-x64-msvc": "1.13.3",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.5",
    "husky": "^9.1.1",
    "lint-staged": "16.1.0",
    "next": "^16.3.8",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "@swc/core",
      "sharp"
    ],
    "overrides": {
      "eslint": "^9.39.5",
      "@typescript-eslint/eslint-plugin": "^8.71.2",
      "@typescript-eslint/parser": "^8.71.2",
      "@typescript-eslint/typescript-estree": "^8.71.2",
      "@swc/core": "1.13.3",
      "@swc/core-win32-x64-msvc": "1.13.3",
      "brace-expansion@>=1.0.0 <1.1.21": "^1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "lodash@>=4.0.0 <4.18.0": "^4.18.1",
      "tmp@<0.2.6": "^0.2.7",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "fast-uri@>=3.0.0 <3.1.8": "^3.1.8",
      "ajv@>=6.0.0 <6.14.0": "^6.14.0",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "js-yaml@<4.1.0": "^4.1.1"
    }
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint-config-prettier": "10.1.5",
    "lucide-react": "0.513.0",
    "playwright": "^1.52.0",
    "zod": "^4.6.5"
  }
}
