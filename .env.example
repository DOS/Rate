# No app loads a root .env at runtime; use the per-app examples:
#   apps/web/.env.example       -> apps/web/.env.local  (Next.js, rate.vn)
#   apps/importer/.env.example  -> apps/importer/.env   (@repo/crawlers engine)
# Two test scripts fall back to the repo root for shared keys:
#   apps/importer/src/shopee/test-ai-enricher.ts  (apps/importer/.env, then ../../.env)
#   apps/extension/src/test-extension-pipeline.ts (apps/web/.env.local, then root .env.local, .env)
# Never commit a filled-in .env file to this public repository.
