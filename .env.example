# ========================================
# RATE PLATFORM - SHARED ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env and fill in your values
# This file contains shared configs used by multiple apps/packages

# ========================================
# DATABASE
# ========================================
DATABASE_URL=postgresql://JOY:password@localhost:5432/rate_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rate_db
DATABASE_USERNAME=JOY
DATABASE_PASSWORD=password

# ========================================
# REDIS
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# AI SERVICE (OpenAI)
# ========================================
# IMPORTANT: Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# AI Cache Settings
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_CACHE_KEY_PREFIX=ai:analysis:

# AI Rate Limiting
AI_RATE_LIMIT_PER_MINUTE=100
AI_RATE_LIMIT_PER_HOUR=1000

# ========================================
# AWS S3 (for Strapi uploads)
# ========================================
AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=ap-southeast-1
AWS_BUCKET=rate-platform-uploads

# ========================================
# SECURITY & ENCRYPTION
# ========================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
JWT_SECRET=
SESSION_SECRET=

# ========================================
# MONITORING & LOGGING
# ========================================
SENTRY_DSN=
LOG_LEVEL=info
ENABLE_METRICS=true

# ========================================
# ENVIRONMENT
# ========================================
NODE_ENV=development
APP_ENV=development

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_AI_ANALYSIS=true
ENABLE_SPAM_DETECTION=true
ENABLE_FAKE_REVIEW_DETECTION=true
ENABLE_REDIS_CACHE=true

# ========================================
# EXTERNAL SERVICES
# ========================================
# GitHub (for PR creation)
GITHUB_TOKEN=

# Webhook URLs (optional)
WEBHOOK_URL=
WEBHOOK_SECRET=

# ========================================
# DEVELOPMENT SETTINGS
# ========================================
DEBUG=false
VERBOSE_LOGGING=false
MOCK_EXTERNAL_APIS=false